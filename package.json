{
  "name": "Skeleton Plotter",
  "productName": "skeletonplotter",
  "version": "1.0.0",
  "description": "A tool for plotting 3D skeletons of human remains",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "test": "node --test",
    "test:selenium": "npm run package && node --test --test-concurrency=1 tests/selenium/*.selenium.mjs",
    "test:selenium:import": "npm run package && node --test --test-concurrency=1 tests/selenium/import.selenium.mjs"
  },
  "keywords": [],
  "author": {
    "name": "CtrlAltElite",
    "email": ""
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "1.8.0",
    "electron": "43.3.0",
    "electron-chromedriver": "^43.3.0",
    "selenium-webdriver": "^4.47.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "bootstrap": "^5.3.8",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "tar": "^7.5.22"
  }
}
